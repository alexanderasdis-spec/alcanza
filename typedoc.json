{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Alcanza · Documentación del código",
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "exclude": ["src/main.jsx"],
  "tsconfig": "tsconfig.docs.json",
  "out": "docs/codigo",
  "readme": "none",
  "disableGit": true,
  "sourceLinkTemplate": "../../{path}#L{line}",
  "excludeExternals": true,
  "sort": ["source-order"],
  "navigation": { "includeGroups": true },
  "lang": "es",
  "locales": {
    "es": {
      "kind_plural_module": "Archivos",
      "kind_plural_function": "Funciones",
      "kind_plural_variable": "Variables y constantes",
      "kind_plural_type_alias": "Tipos",
      "kind_plural_interface": "Interfaces",
      "kind_plural_property": "Propiedades",
      "kind_plural_parameter": "Parámetros",
      "kind_module": "Archivo",
      "kind_function": "Función",
      "kind_variable": "Variable",
      "kind_type_alias": "Tipo",
      "kind_property": "Propiedad",
      "kind_parameter": "Parámetro",
      "theme_parameters": "Parámetros",
      "theme_type_parameters": "Parámetros de tipo",
      "theme_returns": "Devuelve",
      "theme_defined_in": "Definido en",
      "theme_type_declaration": "Declaración del tipo",
      "theme_on_this_page": "En esta página",
      "theme_settings": "Ajustes",
      "theme_search": "Buscar",
      "theme_member_visibility": "Visibilidad",
      "theme_theme": "Tema",
      "theme_os": "Sistema",
      "theme_light": "Claro",
      "theme_dark": "Oscuro",
      "theme_menu": "Menú",
      "theme_index": "Índice",
      "theme_preparing_search_index": "Preparando el buscador…",
      "theme_loading": "Cargando…",
      "theme_copy": "Copiar",
      "theme_copied": "¡Copiado!",
      "theme_generated_using_typedoc": "Generado con TypeDoc",
      "tag_example": "Ejemplo",
      "tag_throws": "Lanza",
      "tag_returns": "Devuelve",
      "tag_deprecated": "Obsoleto",
      "tag_see": "Ver también",
      "tag_module": "Módulo"
    }
  }
}
