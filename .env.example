# Dirección de la API de Laravel (backend en ~/alcanza-api con Sail).
# Copia este archivo como ".env" si necesitas cambiarla.
VITE_API_URL=http://localhost/api

# Clave pública de Cloudflare Turnstile ("no soy un robot").
# La de prueba siempre aprueba; al desplegar se cambia por la real.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
